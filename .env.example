# LeadKar — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Generated from CLAUDE.md Section 5.

# === App ===
APP_NAME=leadkar
APP_BASE_URL=https://leadkar.pk
API_BASE_URL=https://leadkar.pk/api
ENVIRONMENT=production           # development | staging | production
SECRET_KEY=                      # 64-char random; for signed cookies / admin auth
ADMIN_EMAIL=nayyer@example.com

# === Postgres ===
# Runs as a docker-internal service on this shared host (NOT published to a host
# port by default — 5432/5433 are already taken by invoicegraph/forestwatch).
POSTGRES_DB=leadkar
POSTGRES_USER=leadkar
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leadkar:${POSTGRES_PASSWORD}@postgres:5432/leadkar

# === Redis ===
# Also docker-internal (6379/6380/6381 on the host are taken by other projects).
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === PayPro v2 (Pakistan) ===
# No webhook signing exists; payment is verified via the status API (ggosboi).
PAYPRO_CLIENT_ID=               # provided by PayPro
PAYPRO_CLIENT_SECRET=           # provided by PayPro
PAYPRO_USERNAME=                # MerchantId / userName, e.g. Engs_Tech
PAYPRO_API_BASE_URL=https://demoapi.paypro.com.pk   # live: https://api.paypro.com.pk
PAYPRO_RETURN_URL=https://leadkar.pk/order/success
PAYPRO_CANCEL_URL=https://leadkar.pk/order/pending
PAYPRO_TIMEOUT_SECONDS=20
PAYPRO_TOKEN_TTL_SECONDS=1500   # no documented expiry; also refreshes on 401
PAYPRO_ORDER_DUE_DAYS=7

# === Apify ===
APIFY_API_TOKEN=
APIFY_ACTOR_GMAPS=compass/crawler-google-places
APIFY_MAX_USD_PER_RUN=10        # hard cap; abort if estimate exceeds
APIFY_DEFAULT_LANGUAGE=en
APIFY_TIMEOUT_SECONDS=1800      # 30 min max per run

# === Hetzner Object Storage (S3) ===
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=leadkar-deliverables
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGNED_URL_TTL_HOURS=72

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leadkar.pk
SMTP_FROM_NAME=LeadKar

# === Limits & Guardrails ===
CATALOG_REFRESH_CRON="0 3 1 */3 *"   # 03:00 on day 1 every 3 months
ORDER_DELIVERY_TIMEOUT_HOURS=24
MAX_LEADS_PER_CUSTOM_ORDER=2500

# === Host port mapping (shared-VPS adaptation; consumed by docker-compose.yml) ===
# Default host ports 8000/8001 (backend) and 3000/3001 (frontend) are already in
# use on this box, so LeadKar publishes on 8002/3002. Host nginx proxies to them.
BACKEND_HOST_PORT=8002
FRONTEND_HOST_PORT=3002
